# Public build-time configuration. No secrets belong in this file — Vite inlines
# every VITE_* value into the shipped bundle. Machine-local overrides go in
# .env.local, which .gitignore already excludes via *.local.

# Absolute origin the page is served from, with no trailing slash. It is the
# only place the deployed URL is written: the canonical link, og:url and the
# absolute og:image are all built from it. A social card silently falls back to
# no image when this is wrong, so set it per environment:
#
#   Vercel          Project -> Settings -> Environment Variables
#   GitHub Pages    set for you by .github/workflows/deploy-pages.yml
#   anywhere else   VITE_SITE_URL=https://your.domain npm run build
VITE_SITE_URL=https://hamzahossainx.github.io/Product-in-motion

# Set to 1 only once a baked camera path exists at public/models/camera-path.json.
# Left unset, the site uses its code keyframes and never requests the file — a
# fetch for a bake that is not there is a 404 in every visitor's console.
VITE_CAMERA_BAKE=
